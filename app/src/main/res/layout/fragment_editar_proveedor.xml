<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:id="@+id/llSubHeaderEditarProveedor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginBottom="20dp">

            <ImageView
                android:id="@+id/btnBackEditarProveedor"
                android:layout_width="32dp"
                android:layout_height="32dp"

                android:padding="6dp"
                android:src="@drawable/baseline_arrow_back_24"
                app:tint="#000000"/> <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="Editar Proveedor"
            android:textColor="#000000"
            android:textSize="22sp"
            android:textStyle="bold" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardElevation="2dp"
            app:strokeColor="#149BC3"
            app:strokeWidth="2dp"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nombre del Proveedor"
                    android:textStyle="bold"
                    android:textColor="#000000"/>
                <EditText
                    android:id="@+id/etEditNombreProveedor"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Nombre"
                    android:layout_marginBottom="12dp"
                    android:textSize="14sp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Direccion"
                    android:textStyle="bold"
                    android:textColor="#000000"/>
                <EditText
                    android:id="@+id/etEditDireccionProveedor"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Distrito, municipio, dep"
                    android:layout_marginBottom="12dp"
                    android:textSize="14sp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Contacto Principal (Nombre Completo)"
                    android:textStyle="bold"
                    android:textColor="#000000"/>
                <EditText
                    android:id="@+id/etEditContactoProveedor"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Contacto"
                    android:layout_marginBottom="12dp"
                    android:textSize="14sp"
                    android:inputType="textPersonName"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Telefono del Contacto"
                    android:textStyle="bold"
                    android:textColor="#000000"/>
                <EditText
                    android:id="@+id/etEditTelefonoProveedor"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="2222-2222"
                    android:layout_marginBottom="12dp"
                    android:textSize="14sp"
                    android:inputType="phone"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Correo Electronico"
                    android:textStyle="bold"
                    android:textColor="#000000"/>
                <EditText
                    android:id="@+id/etEditCorreoProveedor"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Cnombre@empresa.sv"
                    android:layout_marginBottom="12dp"
                    android:textSize="14sp"
                    android:inputType="textEmailAddress"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Notas Adicionales"
                    android:textStyle="bold"
                    android:textColor="#000000"/>
                <EditText
                    android:id="@+id/etEditNotasProveedor"
                    android:layout_width="match_parent"
                    android:layout_height="100dp"
                    android:gravity="top|start"
                    android:hint="Confiable en materiales, calidad precio etc"
                    android:textSize="14sp"
                    android:inputType="textMultiLine"
                    android:background="@android:drawable/editbox_background"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <Button
            android:id="@+id/btnGuardarProveedor"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:backgroundTint="#1565C0"
            android:text="Guardar Proveedor"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            app:cornerRadius="10dp" />

        <Button
            android:id="@+id/btnCancelarEditProveedor"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="10dp"
            android:backgroundTint="#90CAF9"
            android:text="Cancelar"
            android:textAllCaps="false"
            android:textColor="#000000"
            android:textStyle="bold"
            app:cornerRadius="10dp"
            android:layout_marginBottom="20dp"/>

    </LinearLayout>
</ScrollView>