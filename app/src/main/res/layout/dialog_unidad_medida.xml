<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="16dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/tv_titulo_dialog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:text="Registrar Nueva Unidad de Medida"
            android:textColor="#000000"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="Nombre de La Unidad"
            android:textColor="#000000"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/et_nombre_unidad"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_input_box"
            android:hint="Kilogramos"
            android:paddingHorizontal="12dp"
            android:textColor="#333333"
            android:textColorHint="#ABABAB"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="Abreviatura"
            android:textColor="#000000"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/et_abreviatura_unidad"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_input_box"
            android:hint="Kg"
            android:paddingHorizontal="12dp"
            android:textColor="#333333"
            android:textColorHint="#ABABAB"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="Descripción y Uso"
            android:textColor="#000000"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/et_descripcion_unidad"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:layout_marginBottom="24dp"
            android:background="@drawable/bg_input_box"
            android:gravity="top|start"
            android:hint="Unidad de masa, usada para acero, cemento etc."
            android:padding="12dp"
            android:textColor="#333333"
            android:textColorHint="#ABABAB"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_confirmar_unidad"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginBottom="8dp"
            android:text="Confirmar Registro"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            app:backgroundTint="#1565C0"
            app:cornerRadius="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_cancelar_unidad"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Cancelar"
            android:textAllCaps="false"
            android:textColor="#1565C0"
            android:textSize="16sp"
            app:backgroundTint="#BBDEFB"
            app:cornerRadius="8dp"
            app:elevation="0dp" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>