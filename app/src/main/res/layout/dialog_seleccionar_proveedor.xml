<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    app:cardCornerRadius="28dp"
    app:cardElevation="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:background="#1565C0"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="24dp">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@android:drawable/ic_menu_agenda"
                app:tint="#FFFFFF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Asignar Proveedor"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:layout_marginStart="14dp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:orientation="horizontal"
                android:background="@android:drawable/edit_text"
                android:backgroundTint="#F2F2F2"
                android:gravity="center_vertical"
                android:paddingHorizontal="14dp"
                android:layout_marginBottom="16dp"
                android:elevation="2dp">
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@android:drawable/ic_menu_search"
                    app:tint="#666666"/>
                <EditText
                    android:id="@+id/edtBuscarProveedorDialog"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="BUSCAR PROVEEDOR"
                    android:textSize="14sp"
                    android:background="@android:color/transparent"
                    android:paddingStart="8dp"
                    android:inputType="textCapCharacters" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Lista de Empresas Disponibles"
                android:textStyle="bold"
                android:textColor="#000000"
                android:textSize="14sp"
                android:layout_marginBottom="8dp"
                android:layout_marginStart="4dp"/>

            <RadioGroup
                android:id="@+id/rgProveedores"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="24dp">

                <RadioButton
                    android:id="@+id/rbProvConstru_SAl"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="• Construsal S.A. de C.V.\n  Tel: 2244-8888 | San Salvador"
                    android:textColor="#000000"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:paddingVertical="8dp"
                    android:buttonTint="#1565C0"/>

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#E0E0E0" android:layout_marginVertical="6dp"/>

                <RadioButton
                    android:id="@+id/rbProvFerro_Centro"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="• Ferrocentro UES\n  Tel: 2511-2000 | Santa Ana"
                    android:textColor="#000000"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:paddingVertical="8dp"
                    android:buttonTint="#1565C0"/>

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#E0E0E0" android:layout_marginVertical="6dp"/>

                <RadioButton
                    android:id="@+id/rbProvEl_Angel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="• Distribuidora El Ángel\n  Tel: 2999-1111 | San Miguel"
                    android:textColor="#000000"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:paddingVertical="8dp"
                    android:buttonTint="#1565C0"/>
            </RadioGroup>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnConfirmarProveedor"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="Confirmar Proveedor"
                android:textAllCaps="false"
                android:textStyle="bold"
                app:backgroundTint="#1565C0"
                app:cornerRadius="25dp"
                android:layout_marginBottom="12dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelarProveedor"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="Cancelar"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:textColor="#1565C0"
                app:backgroundTint="#A9C9E8"
                app:cornerRadius="25dp"/>
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>