<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <ImageView
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_marginBottom="24dp"
            android:src="@drawable/ic_lock"
            app:tint="#1565C0" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="Recuperar Contraseña"
            android:textColor="#000000"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp"
            android:text="Ingresa tu correo registrado y tu nueva contraseña para actualizarla en el sistema."
            android:textAlignment="center"
            android:textColor="#555555"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/et_correo_recuperacion"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_input_box"
            android:hint="Correo Electrónico"
            android:inputType="textEmailAddress"
            android:paddingHorizontal="16dp"
            android:textColor="#333333"
            android:textColorHint="#ABABAB" />

        <EditText
            android:id="@+id/et_nueva_password"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_input_box"
            android:hint="Nueva Contraseña"
            android:inputType="textPassword"
            android:paddingHorizontal="16dp"
            android:textColor="#333333"
            android:textColorHint="#ABABAB" />

        <EditText
            android:id="@+id/et_confirmar_password"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginBottom="32dp"
            android:background="@drawable/bg_input_box"
            android:hint="Confirmar Nueva Contraseña"
            android:inputType="textPassword"
            android:paddingHorizontal="16dp"
            android:textColor="#333333"
            android:textColorHint="#ABABAB" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_actualizar_password"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginBottom="16dp"
            android:text="Actualizar en la BD"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            app:backgroundTint="#1565C0"
            app:cornerRadius="12dp" />

        <TextView
            android:id="@+id/tv_volver_login"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="Cancelar y volver al Login"
            android:textColor="#1565C0"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>