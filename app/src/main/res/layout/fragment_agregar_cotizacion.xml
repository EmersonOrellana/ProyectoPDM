<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F2F2F2"
    android:fillViewport="true">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <LinearLayout
            android:id="@+id/lytHeaderCotizacion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Registro de Cotización"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="#000000" />

                <TextView
                    android:id="@+id/txtSubtituloProyecto"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Proyecto X"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#7A6E6E" />
            </LinearLayout>
        </LinearLayout>

        <androidx.cardview.widget.CardView
            android:id="@+id/cardRequerimientos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/lytHeaderCotizacion"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp"
                android:gravity="center_horizontal">
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardProveedorCotizacion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="2dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="20dp">

                        <TextView
                            android:id="@+id/lblProveedorSecc"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Proveedor de la Cotización"
                            android:textStyle="bold"
                            android:textSize="18sp"
                            android:textColor="#000000"
                            android:layout_marginBottom="14dp"/>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnElegirProveedor"
                            android:layout_width="180dp"
                            android:layout_height="wrap_content"
                            android:layout_below="@id/lblProveedorSecc"
                            android:text="Seleccionar\nProveedor"
                            android:textAllCaps="false"
                            android:textSize="12sp"
                            android:gravity="center"
                            android:textColor="#FFFFFF"
                            app:backgroundTint="#1565C0"
                            app:icon="@android:drawable/ic_menu_agenda"
                            app:iconGravity="start"
                            app:cornerRadius="20dp" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_below="@id/lblProveedorSecc"
                            android:layout_toEndOf="@id/btnElegirProveedor"
                            android:layout_marginStart="16dp"
                            android:layout_centerVertical="true"
                            android:orientation="vertical"
                            android:layout_marginTop="6dp">


                            <TextView
                                android:id="@+id/txtContactoProveedor"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="(Asigne una empresa)"
                                android:textColor="#666666"
                                android:textSize="14sp"
                                android:layout_marginStart="10dp"/>
                        </LinearLayout>
                    </RelativeLayout>
                </androidx.cardview.widget.CardView>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Requerimientos de Materiales"
                    android:textStyle="bold"
                    android:textSize="19sp"
                    android:textColor="#000000"
                    android:layout_marginBottom="12dp"/>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#D9D3D3"
                    android:layout_marginBottom="16dp"/>

                <TableLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:stretchColumns="*">

                    <TableRow android:layout_marginBottom="12dp">
                        <TextView android:text="Material" android:textStyle="bold" android:textColor="#000000" android:gravity="center" android:textSize="13sp"/>
                        <TextView android:text="Cantidad" android:textStyle="bold" android:textColor="#000000" android:gravity="center" android:textSize="13sp"/>
                        <TextView android:text="Unidad de\nMedida" android:textStyle="bold" android:textColor="#000000" android:gravity="center" android:textSize="13sp"/>
                        <TextView android:text="Precio\nUnitario" android:textStyle="bold" android:textColor="#000000" android:gravity="center" android:textSize="13sp"/>
                        <TextView android:text="Subtotal" android:textStyle="bold" android:textColor="#000000" android:gravity="center" android:textSize="13sp"/>
                    </TableRow>

                    <TableRow android:layout_marginBottom="10dp">
                        <TextView android:text="Cemento" android:textColor="#333333" android:gravity="center" android:textSize="14sp"/>
                        <TextView android:text="100" android:textColor="#333333" android:gravity="center" android:textSize="14sp"/>
                        <TextView android:text="U" android:textColor="#333333" android:gravity="center" android:textSize="14sp"/>
                        <TextView android:text="-" android:textColor="#333333" android:gravity="center" android:textSize="14sp"/>
                        <TextView android:text="-" android:textColor="#333333" android:gravity="center" android:textSize="14sp"/>
                    </TableRow>

                    <TableRow android:layout_marginBottom="10dp">
                        <TextView android:text="Hierro" android:textColor="#333333" android:gravity="center" android:textSize="14sp"/>
                        <TextView android:text="2" android:textColor="#333333" android:gravity="center" android:textSize="14sp"/>
                        <TextView android:text="qq" android:textColor="#333333" android:gravity="center" android:textSize="14sp"/>
                        <TextView android:text="-" android:textColor="#333333" android:gravity="center" android:textSize="14sp"/>
                        <TextView android:text="-" android:textColor="#333333" android:gravity="center" android:textSize="14sp"/>
                    </TableRow>

                    <TableRow android:layout_marginBottom="10dp">
                        <TextView android:text="Ladrillo" android:textColor="#333333" android:gravity="center" android:textSize="14sp"/>
                        <TextView android:text="5" android:textColor="#333333" android:gravity="center" android:textSize="14sp"/>
                        <TextView android:text="U" android:textColor="#333333" android:gravity="center" android:textSize="14sp"/>
                        <TextView android:text="-" android:textColor="#333333" android:gravity="center" android:textSize="14sp"/>
                        <TextView android:text="-" android:textColor="#333333" android:gravity="center" android:textSize="14sp"/>
                    </TableRow>

                    <TableRow android:layout_marginBottom="16dp">
                        <TextView android:text="Grava" android:textColor="#333333" android:gravity="center" android:textSize="14sp"/>
                        <TextView android:text="10" android:textColor="#333333" android:gravity="center" android:textSize="14sp"/>
                        <TextView android:text="m3" android:textColor="#333333" android:gravity="center" android:textSize="14sp"/>
                        <TextView android:text="-" android:textColor="#333333" android:gravity="center" android:textSize="14sp"/>
                        <TextView android:text="-" android:textColor="#333333" android:gravity="center" android:textSize="14sp"/>
                    </TableRow>
                </TableLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnModificarMaterialesCotizacion"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="Modificar"
                    android:textAllCaps="false"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    app:backgroundTint="#1565C0"
                    app:cornerRadius="12dp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:id="@+id/cardTransporte"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/cardRequerimientos"
            android:layout_marginBottom="20dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp"
                android:gravity="center_horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Transporte"
                    android:textStyle="bold"
                    android:textSize="19sp"
                    android:textColor="#000000"
                    android:layout_marginBottom="12dp"/>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#D9D3D3"
                    android:layout_marginBottom="16dp"/>

                <TextView
                    android:id="@+id/txtTransportistaAsignado"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Transportes Losano"
                    android:textColor="#555555"
                    android:textSize="16sp"
                    android:layout_marginBottom="16dp"
                    android:layout_gravity="start"
                    android:layout_marginStart="8dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAgregarTransporteCotizacion"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="Agregar Transporte"
                    android:textAllCaps="false"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    app:backgroundTint="#1565C0"
                    app:cornerRadius="12dp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGuardarCotizacionFinal"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_below="@id/cardTransporte"
            android:text="Guardar Cotización"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            app:backgroundTint="#0D47A1"
            app:icon="@android:drawable/ic_menu_save"
            app:iconGravity="textStart"
            app:iconPadding="10dp"
            app:cornerRadius="12dp"
            android:layout_marginBottom="16dp"/>

    </RelativeLayout>
</ScrollView>