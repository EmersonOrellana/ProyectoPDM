<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:id="@+id/llSubHeaderVerPerfil"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="Mi Perfil"
                android:textColor="#000000"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardElevation="2dp"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <androidx.cardview.widget.CardView
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:layout_gravity="center"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#E0E0E0"
                    app:strokeWidth="1dp"
                    app:strokeColor="#BDBDBD"
                    android:layout_marginBottom="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical">
                        <ImageView
                            android:layout_width="50dp"
                            android:layout_height="50dp"
                            android:src="@drawable/baseline_person_24"
                            app:tint="#424242"/>
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="#1565C0"
                            android:gravity="center"
                            android:padding="5dp"
                            android:text="Subir Foto"
                            android:textColor="#FFFFFF"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="2"
                    android:alignmentMode="alignMargins">

                    <LinearLayout android:layout_width="0dp" android:layout_columnWeight="1" android:orientation="vertical" android:paddingEnd="8dp">
                        <TextView android:text="Nombre" android:textStyle="bold" android:textColor="#000000" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        <EditText android:id="@+id/etVerNombre" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Nombre" android:textColor="#757575" android:textSize="14sp" android:focusable="false" android:cursorVisible="false"/>
                    </LinearLayout>

                    <LinearLayout android:layout_width="0dp" android:layout_columnWeight="1" android:orientation="vertical" android:paddingStart="8dp">
                        <TextView android:text="Apellidos" android:textStyle="bold" android:textColor="#000000" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        <EditText android:id="@+id/etVerApellidos" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Apellidos" android:textColor="#757575" android:textSize="14sp" android:focusable="false" android:cursorVisible="false"/>
                    </LinearLayout>

                    <LinearLayout android:layout_width="0dp" android:layout_columnWeight="1" android:orientation="vertical" android:paddingEnd="8dp" android:layout_marginTop="10dp">
                        <TextView android:text="Usuario" android:textStyle="bold" android:textColor="#000000" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        <EditText android:id="@+id/etVerUser" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Cgomez" android:textColor="#757575" android:textSize="14sp" android:focusable="false" android:cursorVisible="false"/>
                    </LinearLayout>

                    <LinearLayout android:layout_width="0dp" android:layout_columnWeight="1" android:orientation="vertical" android:paddingStart="8dp" android:layout_marginTop="10dp">
                        <TextView android:text="NIT" android:textStyle="bold" android:textColor="#000000" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        <EditText android:id="@+id/etVerNit" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="00000000-0" android:textColor="#757575" android:textSize="14sp" android:focusable="false" android:cursorVisible="false"/>
                    </LinearLayout>
                </GridLayout>

                <TextView android:text="Fecha de Registro" android:textStyle="bold" android:textColor="#000000" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="15dp"/>
                <EditText android:id="@+id/etVerFecha" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="DD/MM/YYYY" android:textColor="#757575" android:textSize="14sp" android:drawableEnd="@android:drawable/ic_menu_my_calendar" android:focusable="false" android:cursorVisible="false"/>

                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="2"
                    android:alignmentMode="alignMargins"
                    android:layout_marginTop="10dp">

                    <LinearLayout android:layout_width="0dp" android:layout_columnWeight="1" android:orientation="vertical" android:paddingEnd="8dp">
                        <TextView android:text="Telefono" android:textStyle="bold" android:textColor="#000000" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        <EditText android:id="@+id/etVerTelefono" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="2222-2222" android:textColor="#757575" android:textSize="14sp" android:focusable="false" android:cursorVisible="false"/>
                    </LinearLayout>

                    <LinearLayout android:layout_width="0dp" android:layout_columnWeight="1" android:orientation="vertical" android:paddingStart="8dp">
                        <TextView android:text="Rol" android:textStyle="bold" android:textColor="#000000" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        <EditText android:id="@+id/etVerRol" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Administrador" android:textColor="#757575" android:textSize="14sp" android:focusable="false" android:cursorVisible="false"/>
                    </LinearLayout>
                </GridLayout>

                <TextView android:text="Correo Electronico (coorporativo)" android:textStyle="bold" android:textColor="#000000" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="15dp"/>
                <EditText android:id="@+id/etVerCorreo" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="nombre@Empresa.sv" android:textColor="#757575" android:textSize="14sp" android:focusable="false" android:cursorVisible="false"/>

                <Button
                    android:id="@+id/btnIrAEditarPerfil"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:layout_marginTop="30dp"
                    android:backgroundTint="#1565C0"
                    android:text="Editar Perfil"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    app:cornerRadius="10dp" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>