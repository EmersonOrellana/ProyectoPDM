<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:layout_marginStart="4dp"
            android:text="Mi Perfil"
            android:textColor="#000000"
            android:textSize="22sp"
            android:textStyle="bold" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="24dp"
            app:cardElevation="2dp"
            app:strokeColor="#1565C0"
            app:strokeWidth="1dp"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:layout_gravity="center"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#E0E0E0"
                    app:strokeWidth="1dp"
                    app:strokeColor="#1565C0"
                    android:layout_marginBottom="24dp">
                    <ImageView
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:layout_gravity="center"
                        android:src="@drawable/baseline_person_24"
                        app:tint="#424242"/>
                </com.google.android.material.card.MaterialCardView>

                <TextView android:text="Nombre" android:textStyle="bold" android:textColor="#000000" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                <EditText android:id="@+id/etVerNombre" android:layout_width="match_parent" android:layout_height="50dp" android:background="@drawable/bg_input_rounded" android:text="Nombre" android:textColor="#757575" android:textSize="14sp" android:paddingHorizontal="16dp" android:focusable="false" android:layout_marginBottom="12dp"/>

                <TextView android:text="Apellidos" android:textStyle="bold" android:textColor="#000000" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                <EditText android:id="@+id/etVerApellidos" android:layout_width="match_parent" android:layout_height="50dp" android:background="@drawable/bg_input_rounded" android:text="Apellidos" android:textColor="#757575" android:textSize="14sp" android:paddingHorizontal="16dp" android:focusable="false" android:layout_marginBottom="12dp"/>

                <TextView android:text="Usuario" android:textStyle="bold" android:textColor="#000000" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                <EditText android:id="@+id/etVerUser" android:layout_width="match_parent" android:layout_height="50dp" android:background="@drawable/bg_input_rounded" android:text="Cgomez" android:textColor="#757575" android:textSize="14sp" android:paddingHorizontal="16dp" android:focusable="false" android:layout_marginBottom="12dp"/>

                <TextView android:text="NIT" android:textStyle="bold" android:textColor="#000000" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                <EditText android:id="@+id/etVerNit" android:layout_width="match_parent" android:layout_height="50dp" android:background="@drawable/bg_input_rounded" android:text="00000000-0" android:textColor="#757575" android:textSize="14sp" android:paddingHorizontal="16dp" android:focusable="false" android:layout_marginBottom="12dp"/>

                <TextView android:text="Fecha de Registro" android:textStyle="bold" android:textColor="#000000" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                <EditText android:id="@+id/etVerFecha" android:layout_width="match_parent" android:layout_height="50dp" android:background="@drawable/bg_input_rounded" android:text="DD/MM/YYYY" android:textColor="#757575" android:textSize="14sp" android:paddingHorizontal="16dp" android:focusable="false" android:layout_marginBottom="12dp"/>

                <TextView android:text="Telefono" android:textStyle="bold" android:textColor="#000000" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                <EditText android:id="@+id/etVerTelefono" android:layout_width="match_parent" android:layout_height="50dp" android:background="@drawable/bg_input_rounded" android:text="2222-2222" android:textColor="#757575" android:textSize="14sp" android:paddingHorizontal="16dp" android:focusable="false" android:layout_marginBottom="12dp"/>

                <TextView android:text="Rol" android:textStyle="bold" android:textColor="#000000" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                <EditText android:id="@+id/etVerRol" android:layout_width="match_parent" android:layout_height="50dp" android:background="@drawable/bg_input_rounded" android:text="Administrador" android:textColor="#757575" android:textSize="14sp" android:paddingHorizontal="16dp" android:focusable="false" android:layout_marginBottom="12dp"/>

                <TextView android:text="Correo Electronico" android:textStyle="bold" android:textColor="#000000" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                <EditText android:id="@+id/etVerCorreo" android:layout_width="match_parent" android:layout_height="50dp" android:background="@drawable/bg_input_rounded" android:text="nombre@Empresa.sv" android:textColor="#757575" android:textSize="14sp" android:paddingHorizontal="16dp" android:focusable="false" android:layout_marginBottom="24dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnIrAEditarPerfil"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:layout_marginBottom="8dp"
                    app:backgroundTint="#0D47A1"
                    android:text="Editar Perfil"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:cornerRadius="12dp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>