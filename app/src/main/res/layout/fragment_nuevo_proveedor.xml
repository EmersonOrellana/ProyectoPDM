<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:text="Nuevo Proveedor"
            android:textColor="#000000"
            android:textSize="24sp"
            android:textStyle="bold" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="#FFFFFF"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nombre del Proveedor"
                    android:textStyle="bold"
                    android:textColor="#000000"
                    android:layout_marginBottom="6dp"/>
                <EditText
                    android:id="@+id/etNombreProveedor"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:hint="Ej. Materiales El Constructor"
                    android:background="@drawable/bg_edittext"
                    android:paddingHorizontal="16dp"
                    android:layout_marginBottom="16dp"
                    android:textSize="14sp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Dirección"
                    android:textStyle="bold"
                    android:textColor="#000000"
                    android:layout_marginBottom="6dp"/>
                <EditText
                    android:id="@+id/etDireccionProveedor"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:hint="Distrito, municipio, dep"
                    android:background="@drawable/bg_edittext"
                    android:paddingHorizontal="16dp"
                    android:layout_marginBottom="16dp"
                    android:textSize="14sp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Contacto Principal"
                    android:textStyle="bold"
                    android:textColor="#000000"
                    android:layout_marginBottom="6dp"/>
                <EditText
                    android:id="@+id/etContactoProveedor"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:hint="Nombre completo"
                    android:background="@drawable/bg_edittext"
                    android:paddingHorizontal="16dp"
                    android:layout_marginBottom="16dp"
                    android:textSize="14sp"
                    android:inputType="textPersonName"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Teléfono"
                    android:textStyle="bold"
                    android:textColor="#000000"
                    android:layout_marginBottom="6dp"/>
                <EditText
                    android:id="@+id/etTelefonoProveedor"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:hint="2222-2222"
                    android:background="@drawable/bg_edittext"
                    android:paddingHorizontal="16dp"
                    android:layout_marginBottom="16dp"
                    android:textSize="14sp"
                    android:inputType="phone"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Correo Electrónico"
                    android:textStyle="bold"
                    android:textColor="#000000"
                    android:layout_marginBottom="6dp"/>
                <EditText
                    android:id="@+id/etCorreoProveedor"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:hint="Cnombre@empresa.sv"
                    android:background="@drawable/bg_edittext"
                    android:paddingHorizontal="16dp"
                    android:layout_marginBottom="16dp"
                    android:textSize="14sp"
                    android:inputType="textEmailAddress"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Notas Adicionales"
                    android:textStyle="bold"
                    android:textColor="#000000"
                    android:layout_marginBottom="6dp"/>
                <EditText
                    android:id="@+id/etNotasProveedor"
                    android:layout_width="match_parent"
                    android:layout_height="100dp"
                    android:gravity="top|start"
                    android:padding="16dp"
                    android:hint="Confiable en materiales, calidad precio..."
                    android:textSize="14sp"
                    android:inputType="textMultiLine"
                    android:background="@drawable/bg_edittext"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAgregarProveedor"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="Agregar Proveedor"
            android:textColor="#FFFFFF"
            android:textAllCaps="false"
            android:textStyle="bold"
            app:backgroundTint="#1565C0"
            app:cornerRadius="12dp"
            android:layout_marginBottom="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelarProveedor"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="Cancelar"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textColor="#1565C0"
            app:backgroundTint="#A9C9E8"
            app:cornerRadius="12dp"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>

    </LinearLayout>
</ScrollView>