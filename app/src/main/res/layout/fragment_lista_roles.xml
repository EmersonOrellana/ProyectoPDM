<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/llSubHeaderRoles"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="20dp">

            <ImageView
                android:id="@+id/btnBackListaRoles"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:padding="6dp"
                android:src="@drawable/baseline_arrow_back_24"
                app:tint="#000000" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="Roles"
                android:textColor="#000000"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <EditText
            android:id="@+id/etBuscarRol"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginHorizontal="20dp"
            android:layout_marginBottom="20dp"
            android:background="@android:drawable/editbox_background"
            android:drawableStart="@android:drawable/ic_menu_search"
            android:drawablePadding="10dp"
            android:hint="BUSCAR"
            android:paddingStart="15dp"
            android:paddingEnd="15dp"
            android:singleLine="true"
            android:textSize="14sp" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="80dp">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="20dp"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="@android:color/white"
                    app:strokeColor="#1565C0"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="ROL: Administrador"
                            android:textColor="#000000"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnEditarRolAdmin"
                                android:layout_width="100dp"
                                android:layout_height="36dp"
                                android:text="Editar"
                                android:textAllCaps="false"
                                android:textColor="#1565C0"
                                android:textSize="12sp"
                                app:backgroundTint="#A9C9E8"
                                app:cornerRadius="8dp"
                                app:icon="@android:drawable/ic_menu_edit"
                                app:iconTint="#1565C0"
                                app:iconSize="14dp"
                                app:iconPadding="4dp"/>

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnEliminarRolAdmin"
                                android:layout_width="100dp"
                                android:layout_height="36dp"
                                android:layout_marginTop="4dp"
                                android:text="Eliminar"
                                android:textAllCaps="false"
                                android:textColor="#FFFFFF"
                                android:textSize="12sp"
                                app:backgroundTint="#F1948A"
                                app:cornerRadius="8dp"
                                app:icon="@android:drawable/ic_menu_delete"
                                app:iconTint="#FFFFFF"
                                app:iconSize="14dp"
                                app:iconPadding="4dp"/>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="20dp"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="@android:color/white"
                    app:strokeColor="#1565C0"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="ROL: Operativo"
                            android:textColor="#000000"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnEditarRolOperativo"
                                android:layout_width="100dp"
                                android:layout_height="36dp"
                                android:text="Editar"
                                android:textAllCaps="false"
                                android:textColor="#1565C0"
                                android:textSize="12sp"
                                app:backgroundTint="#A9C9E8"
                                app:cornerRadius="8dp"
                                app:icon="@android:drawable/ic_menu_edit"
                                app:iconTint="#1565C0"
                                app:iconSize="14dp"
                                app:iconPadding="4dp"/>

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnEliminarRolOperativo"
                                android:layout_width="100dp"
                                android:layout_height="36dp"
                                android:layout_marginTop="4dp"
                                android:text="Eliminar"
                                android:textAllCaps="false"
                                android:textColor="#FFFFFF"
                                android:textSize="12sp"
                                app:backgroundTint="#F1948A"
                                app:cornerRadius="8dp"
                                app:icon="@android:drawable/ic_menu_delete"
                                app:iconTint="#FFFFFF"
                                app:iconSize="14dp"
                                app:iconPadding="4dp"/>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAgregarRol"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="20dp"
        app:backgroundTint="#1565C0"
        android:src="@android:drawable/ic_input_add"
        app:tint="#FFFFFF"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:borderWidth="0dp"
        app:fabSize="normal" />

</androidx.constraintlayout.widget.ConstraintLayout>