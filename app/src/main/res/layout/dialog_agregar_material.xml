<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:layout_margin="0dp"
    app:cardCornerRadius="28dp"
    app:cardElevation="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp"
            android:text="Agregar Materiales"
            android:textColor="#000000"
            android:textSize="22sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:orientation="horizontal"
            android:background="@android:drawable/edit_text"
            android:backgroundTint="#F2F2F2"
            android:gravity="center_vertical"
            android:paddingHorizontal="14dp"
            android:layout_marginBottom="10dp"
            android:elevation="2dp">
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@android:drawable/ic_menu_search"
                app:tint="#666666"/>
            <EditText
                android:id="@+id/edtBuscarMaterialDialog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="BUSCAR MATERIAL"
                android:textSize="14sp"
                android:textColorHint="#888888"
                android:background="@android:color/transparent"
                android:paddingStart="8dp"
                android:inputType="textCapCharacters" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Resultado de la Busqueda"
            android:textColor="#666666"
            android:textSize="14sp"
            android:layout_marginBottom="8dp"
            android:layout_marginStart="4dp"/>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="140dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            android:backgroundTint="#F2F2F2"
            app:cardMaxElevation="0dp"
            android:layout_marginBottom="20dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="12dp">

                <androidx.core.widget.NestedScrollView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scrollbars="vertical"
                    android:background="#FFFFFF"
                    android:backgroundTint="#FFFFFF"
                    android:padding="8dp">

                    <RadioGroup
                        android:id="@+id/rgMaterialesResultado"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <RadioButton
                            android:id="@+id/rbMaterialGrava"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Grava"
                            android:textColor="#000000"
                            android:textSize="16sp"
                            android:layout_marginBottom="6dp"/>

                        <RadioButton
                            android:id="@+id/rbMaterialCemento"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Cemento"
                            android:textColor="#000000"
                            android:textSize="16sp"
                            android:layout_marginBottom="6dp"/>

                        <RadioButton
                            android:id="@+id/rbMaterialArena"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Arena"
                            android:textColor="#000000"
                            android:textSize="16sp"/>
                    </RadioGroup>
                </androidx.core.widget.NestedScrollView>
            </FrameLayout>
        </androidx.cardview.widget.CardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2"
            android:layout_marginBottom="28dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginEnd="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CANTIDAD"
                    android:textStyle="bold"
                    android:textColor="#000000"
                    android:textSize="14sp"
                    android:layout_marginBottom="6dp"/>

                <EditText
                    android:id="@+id/edtDialogCantidad"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:background="@android:drawable/edit_text"
                    android:backgroundTint="#F2F2F2"
                    android:elevation="2dp"
                    android:inputType="numberDecimal"
                    android:paddingHorizontal="12dp"
                    android:textSize="16sp"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="UNIDAD"
                    android:textStyle="bold"
                    android:textColor="#000000"
                    android:textSize="14sp"
                    android:layout_marginBottom="6dp"/>

                <Spinner
                    android:id="@+id/spDialogUnidad"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:background="@android:drawable/btn_dropdown"
                    android:backgroundTint="#F2F2F2"
                    android:elevation="2dp"
                    android:spinnerMode="dropdown"/>
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDialogAgregarMaterial"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Agregar"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            app:backgroundTint="#1565C0"
            app:cornerRadius="25dp"
            android:layout_marginBottom="12dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDialogCancelarMaterial"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Cancelar"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textColor="#1565C0"
            app:backgroundTint="#A9C9E8"
            app:cornerRadius="25dp"/>

    </LinearLayout>
</androidx.cardview.widget.CardView>