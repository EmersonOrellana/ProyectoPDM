<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    android:padding="20dp">

    <TextView
        android:id="@+id/tvTituloEditar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:text="Editar Material"
        android:textColor="#000000"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="20dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="2dp"
        app:cardBackgroundColor="@android:color/white"
        app:strokeColor="#1565C0"
        app:strokeWidth="1dp"
        app:layout_constraintTop_toBottomOf="@id/tvTituloEditar"
        app:layout_constraintBottom_toTopOf="@id/btnActualizarMaterial">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Nombre del Material" android:textColor="#000000" android:textStyle="bold" android:layout_marginBottom="6dp" />
                <EditText android:id="@+id/etNombreMaterial" android:layout_width="match_parent" android:layout_height="50dp" android:background="@drawable/bg_edittext" android:paddingHorizontal="16dp" android:hint="Material" android:layout_marginBottom="16dp" />

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Categoría" android:textColor="#000000" android:textStyle="bold" android:layout_marginBottom="6dp" />
                <Spinner android:id="@+id/spCategoriaMaterial" android:layout_width="match_parent" android:layout_height="50dp" android:background="@drawable/bg_edittext" android:layout_marginBottom="16dp"/>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Unidad de medida" android:textColor="#000000" android:textStyle="bold" android:layout_marginBottom="6dp" />
                <EditText android:id="@+id/etUnidadMaterial" android:layout_width="match_parent" android:layout_height="50dp" android:background="@drawable/bg_edittext" android:paddingHorizontal="16dp" android:hint="Sacos" android:layout_marginBottom="16dp" />

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Descripción técnica" android:textColor="#000000" android:textStyle="bold" android:layout_marginBottom="6dp" />
                <EditText android:id="@+id/etDescripcionMaterial" android:layout_width="match_parent" android:layout_height="100dp" android:background="@drawable/bg_edittext" android:padding="16dp" android:gravity="top|start" android:hint="Detalles..." android:inputType="textMultiLine" />

            </LinearLayout>
        </ScrollView>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnActualizarMaterial"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:textColor="#FFFFFF"
        android:text="Actualizar Material"
        android:textAllCaps="false"
        android:textStyle="bold"
        app:backgroundTint="#1565C0"
        app:cornerRadius="12dp"
        android:layout_marginBottom="12dp"
        app:layout_constraintBottom_toTopOf="@id/btnCancelarEditar" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCancelarEditar"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:text="Cancelar"
        android:textAllCaps="false"
        android:textStyle="bold"
        android:textColor="#1565C0"
        app:backgroundTint="#A9C9E8"
        app:cornerRadius="12dp"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>