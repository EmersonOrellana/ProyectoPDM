<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvTituloRegistrar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginStart="8dp"
        android:text="Registrar Nuevo Material"
        android:textColor="#000000"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="4dp"
        app:cardBackgroundColor="#FFFFFF"
        app:layout_constraintTop_toBottomOf="@id/tvTituloRegistrar"
        app:layout_constraintBottom_toTopOf="@id/btnCrearMaterial"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="20dp">

                <TextView
                    android:id="@+id/lblNombreNuevo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nombre del Material"
                    android:textColor="#000000"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <EditText
                    android:id="@+id/etNombreNuevoMaterial"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="6dp"
                    android:background="@android:drawable/editbox_background_normal"
                    android:backgroundTint="#EAEAEA"
                    android:hint="Material"
                    android:inputType="text"
                    android:paddingHorizontal="12dp"
                    android:textColor="#000000"
                    android:textSize="15sp"
                    app:layout_constraintTop_toBottomOf="@id/lblNombreNuevo" />

                <TextView
                    android:id="@+id/lblCategoriaNueva"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Categoría"
                    android:textColor="#000000"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:layout_constraintTop_toBottomOf="@id/etNombreNuevoMaterial"
                    app:layout_constraintStart_toStartOf="parent" />

                <Spinner
                    android:id="@+id/spCategoriaNuevoMaterial"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="6dp"
                    android:background="@android:drawable/btn_dropdown"
                    android:backgroundTint="#EAEAEA"
                    android:paddingHorizontal="12dp"
                    app:layout_constraintTop_toBottomOf="@id/lblCategoriaNueva" />

                <TextView
                    android:id="@+id/lblUnidadNueva"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Unidad de medida por defecto"
                    android:textColor="#000000"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:layout_constraintTop_toBottomOf="@id/spCategoriaNuevoMaterial"
                    app:layout_constraintStart_toStartOf="parent" />

                <EditText
                    android:id="@+id/etUnidadNuevoMaterial"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="6dp"
                    android:background="@android:drawable/editbox_background_normal"
                    android:backgroundTint="#EAEAEA"
                    android:hint="Sacos"
                    android:inputType="text"
                    android:paddingHorizontal="12dp"
                    android:textColor="#000000"
                    android:textSize="15sp"
                    app:layout_constraintTop_toBottomOf="@id/lblUnidadNueva" />

                <TextView
                    android:id="@+id/lblDescripcionNueva"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Descripción técnica"
                    android:textColor="#000000"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:layout_constraintTop_toBottomOf="@id/etUnidadNuevoMaterial"
                    app:layout_constraintStart_toStartOf="parent" />

                <EditText
                    android:id="@+id/etDescripcionNuevoMaterial"
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:layout_marginTop="6dp"
                    android:background="@android:drawable/editbox_background_normal"
                    android:backgroundTint="#EAEAEA"
                    android:gravity="top|start"
                    android:hint="Para que funciona, peso etc."
                    android:inputType="textMultiLine"
                    android:padding="12dp"
                    android:textColor="#000000"
                    android:textSize="15sp"
                    app:layout_constraintTop_toBottomOf="@id/lblDescripcionNueva" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </ScrollView>
    </androidx.cardview.widget.CardView>

    <Button
        android:id="@+id/btnCrearMaterial"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginBottom="8dp"
        android:backgroundTint="#0D47A1"
        android:text="Crear Material"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        app:cornerRadius="10dp"
        app:layout_constraintBottom_toTopOf="@id/btnCancelarRegistrar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/btnCancelarRegistrar"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginBottom="4dp"
        android:backgroundTint="#B3D4F5"
        android:text="Cancelar"
        android:textAllCaps="false"
        android:textColor="#0D47A1"
        android:textSize="16sp"
        android:textStyle="bold"
        app:cornerRadius="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>