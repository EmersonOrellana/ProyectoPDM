<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:layout_margin="0dp"
    app:cardCornerRadius="28dp"
    app:cardElevation="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:background="#1565C0"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="24dp">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@android:drawable/ic_menu_directions"
                app:tint="#FFFFFF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Asignar Transporte"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:layout_marginStart="14dp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:orientation="horizontal"
                android:background="@android:drawable/edit_text"
                android:backgroundTint="#F2F2F2"
                android:gravity="center_vertical"
                android:paddingHorizontal="14dp"
                android:layout_marginBottom="16dp"
                android:elevation="2dp">
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@android:drawable/ic_menu_search"
                    app:tint="#666666"/>
                <EditText
                    android:id="@+id/edtBuscarTransporteDialog"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="BUSCAR TRANSPORTISTA"
                    android:textSize="14sp"
                    android:textColorHint="#888888"
                    android:background="@android:color/transparent"
                    android:paddingStart="8dp"
                    android:inputType="textCapCharacters" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Seleccionar Transportista"
                android:textStyle="bold"
                android:textColor="#000000"
                android:textSize="14sp"
                android:layout_marginBottom="8dp"
                android:layout_marginStart="4dp"/>

            <RadioGroup
                android:id="@+id/rgTransportistas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="24dp">

                <RadioButton
                    android:id="@+id/rbTransLosano"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="• Transportes Losano\n  Placa: C-123456  |  Tel: 2255-0000"
                    android:textColor="#000000"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:paddingVertical="8dp"
                    android:buttonTint="#1565C0"/>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E0E0E0"
                    android:layout_marginVertical="6dp"/>

                <RadioButton
                    android:id="@+id/rbTransPacifico"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="• Fletes del Pacífico\n  Placa: C-789012  |  Tel: 2288-1111"
                    android:textColor="#000000"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:paddingVertical="8dp"
                    android:buttonTint="#1565C0"/>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E0E0E0"
                    android:layout_marginVertical="6dp"/>

                <RadioButton
                    android:id="@+id/rbTransParticular"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="• Particular / Interno\n  Placa: P-456789  |  Tel: 7000-0000"
                    android:textColor="#000000"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:paddingVertical="8dp"
                    android:buttonTint="#1565C0"/>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E0E0E0"
                    android:layout_marginVertical="6dp"/>
            </RadioGroup>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilCostoTransporte"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:hint="Costo de ocupar ese servicio"
                app:boxStrokeColor="#1565C0"
                app:boxCornerRadiusTopStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusBottomEnd="12dp"
                app:hintTextColor="#1565C0">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edtCostoTransporteDialog"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal"
                    android:text="0.00"
                    android:textColor="#000000"
                    android:textSize="16sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnConfirmarTransporte"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="Confirmar"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                app:backgroundTint="#1565C0"
                app:cornerRadius="25dp"
                android:layout_marginBottom="12dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelarTransporte"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="Cancelar"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:textColor="#1565C0"
                app:backgroundTint="#A9C9E8"
                app:cornerRadius="25dp"/>
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>