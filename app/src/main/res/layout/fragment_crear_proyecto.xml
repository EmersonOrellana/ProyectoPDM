<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    android:fillViewport="true">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp">

        <LinearLayout
            android:id="@+id/lytHeaderForm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Crear Proyecto"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="#000000"
                android:layout_marginStart="12dp"/>
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/lytHeaderForm"
            app:cardCornerRadius="24dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@android:color/white"
            app:strokeColor="#1565C0"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Nombre:"
                    android:textColor="#000000"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:layout_marginBottom="6dp" />

                <EditText
                    android:id="@+id/edtFormNombre"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:hint="Proyecto X"
                    android:background="@drawable/bg_edittext"
                    android:paddingHorizontal="16dp"
                    android:inputType="textCapWords"
                    android:textSize="16sp"
                    android:layout_marginBottom="16dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Fecha:"
                    android:textColor="#000000"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:layout_marginBottom="6dp" />

                <EditText
                    android:id="@+id/edtFormFecha"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:hint="DD/MM/YYYY"
                    android:background="@drawable/bg_edittext"
                    android:paddingHorizontal="16dp"
                    android:focusable="false"
                    android:longClickable="false"
                    android:clickable="true"
                    android:drawableEnd="@android:drawable/ic_menu_my_calendar"
                    android:drawableTint="#1565C0"
                    android:textSize="16sp"
                    android:layout_marginBottom="16dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Dirección:"
                    android:textColor="#000000"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:layout_marginBottom="6dp" />

                <EditText
                    android:id="@+id/edtFormDireccion"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:hint="Casa, Dep, Pol"
                    android:background="@drawable/bg_edittext"
                    android:paddingHorizontal="16dp"
                    android:inputType="textPostalAddress"
                    android:textSize="16sp"
                    android:layout_marginBottom="16dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Departamento:"
                    android:textColor="#000000"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:layout_marginBottom="6dp" />

                <Spinner
                    android:id="@+id/spFormDepartamento"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:background="@drawable/bg_edittext"
                    android:layout_marginBottom="16dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Municipio:"
                    android:textColor="#000000"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:layout_marginBottom="6dp" />

                <Spinner
                    android:id="@+id/spFormMunicipio"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:background="@drawable/bg_edittext"
                    android:layout_marginBottom="24dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFormGuardar"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:text="Crear Proyecto"
                    android:textAllCaps="false"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    app:backgroundTint="#1565C0"
                    app:cornerRadius="16dp"
                    android:layout_marginBottom="12dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFormCancelar"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:text="Cancelar"
                    android:textAllCaps="false"
                    android:textStyle="bold"
                    android:textColor="#1565C0"
                    app:backgroundTint="#A9C9E8"
                    app:cornerRadius="16dp"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </RelativeLayout>
</ScrollView>