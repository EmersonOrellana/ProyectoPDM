<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    android:padding="16dp">

    <LinearLayout
        android:id="@+id/lytHeaderRegistrar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_marginTop="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tvTituloRegistrar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Registrar Nuevo Transportista"
            android:textColor="#000000"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="12dp"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/lytHeaderRegistrar"
        app:layout_constraintBottom_toTopOf="@id/btnCrearUsuario">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="4dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="2dp"
            app:strokeColor="#1565C0"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="120dp"
                    android:layout_height="140dp"
                    android:layout_gravity="center"
                    android:layout_marginBottom="16dp">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardFotoPerfil"
                        android:layout_width="120dp"
                        android:layout_height="120dp"
                        app:cardCornerRadius="20dp"
                        app:cardBackgroundColor="#E0E0E0"
                        app:cardElevation="0dp"
                        app:strokeColor="#1565C0"
                        app:strokeWidth="1dp"
                        app:layout_constraintTop_toTopOf="parent">
                        <ImageView
                            android:layout_width="60dp"
                            android:layout_height="60dp"
                            android:layout_gravity="center"
                            android:src="@android:drawable/ic_menu_report_image"
                            app:tint="#666666" />
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSubirFoto"
                        android:layout_width="100dp"
                        android:layout_height="32dp"
                        android:text="Subir Foto"
                        android:textSize="11sp"
                        android:textAllCaps="false"
                        app:backgroundTint="#1565C0"
                        app:cornerRadius="6dp"
                        app:layout_constraintTop_toBottomOf="@id/cardFotoPerfil"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Nombre Completo" android:textStyle="bold" android:textColor="#000000" android:layout_marginBottom="4dp" />
                <EditText android:id="@+id/etNombreCompleto" android:layout_width="match_parent" android:layout_height="50dp" android:background="@drawable/bg_input_rounded" android:hint="Nombre" android:paddingHorizontal="16dp" android:layout_marginBottom="12dp" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:weightSum="2" android:layout_marginBottom="12dp">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginEnd="6dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="DUI" android:textStyle="bold" android:textColor="#000000" android:layout_marginBottom="4dp" />
                        <EditText android:id="@+id/etDui" android:layout_width="match_parent" android:layout_height="50dp" android:background="@drawable/bg_input_rounded" android:hint="00000000-0" android:paddingHorizontal="16dp" android:inputType="number" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="6dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="NIT" android:textStyle="bold" android:textColor="#000000" android:layout_marginBottom="4dp" />
                        <EditText android:id="@+id/etNit" android:layout_width="match_parent" android:layout_height="50dp" android:background="@drawable/bg_input_rounded" android:hint="00000000-0" android:paddingHorizontal="16dp" android:inputType="number" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:weightSum="2" android:layout_marginBottom="12dp">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginEnd="6dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Placa" android:textStyle="bold" android:textColor="#000000" android:layout_marginBottom="4dp" />
                        <EditText android:id="@+id/etPlaca" android:layout_width="match_parent" android:layout_height="50dp" android:background="@drawable/bg_input_rounded" android:hint="P123-456" android:paddingHorizontal="16dp" android:inputType="textCapCharacters" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="6dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="N° de Licencia" android:textStyle="bold" android:textColor="#000000" android:layout_marginBottom="4dp" />
                        <EditText android:id="@+id/etLicencia" android:layout_width="match_parent" android:layout_height="50dp" android:background="@drawable/bg_input_rounded" android:paddingHorizontal="16dp" android:inputType="number" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:weightSum="2" android:layout_marginBottom="12dp">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginEnd="6dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Telefono" android:textStyle="bold" android:textColor="#000000" android:layout_marginBottom="4dp" />
                        <EditText android:id="@+id/etTelefono" android:layout_width="match_parent" android:layout_height="50dp" android:background="@drawable/bg_input_rounded" android:hint="2222-2222" android:paddingHorizontal="16dp" android:inputType="phone" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="6dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Tipo de Licencia" android:textStyle="bold" android:textColor="#000000" android:layout_marginBottom="4dp" />
                        <Spinner android:id="@+id/spTipoLicencia" android:layout_width="match_parent" android:layout_height="50dp" android:background="@drawable/bg_input_rounded" />
                    </LinearLayout>
                </LinearLayout>

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Correo Electronico" android:textStyle="bold" android:textColor="#000000" android:layout_marginBottom="4dp" />
                <EditText android:id="@+id/etCorreoElectronico" android:layout_width="match_parent" android:layout_height="50dp" android:background="@drawable/bg_input_rounded" android:hint="nombre@Empresa.sv" android:paddingHorizontal="16dp" android:inputType="textEmailAddress" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </ScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCrearUsuario"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginBottom="8dp"
        android:text="Crear Usuario"
        android:textStyle="bold"
        android:textAllCaps="false"
        app:backgroundTint="#1565C0"
        app:cornerRadius="12dp"
        app:layout_constraintBottom_toTopOf="@id/btnCancelarRegistro" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCancelarRegistro"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginBottom="16dp"
        android:text="Cancelar"
        android:textStyle="bold"
        android:textAllCaps="false"
        android:textColor="#1565C0"
        app:strokeColor="#1565C0"
        app:cornerRadius="12dp"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>