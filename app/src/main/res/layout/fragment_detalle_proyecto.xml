<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F2F2F2"
    android:fillViewport="true">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <RelativeLayout
            android:id="@+id/lytHeaderDetalle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp">

            <ImageButton
                android:id="@+id/btnAtrasDetalle"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:src="@android:drawable/ic_menu_revert"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="#000000"
                android:contentDescription="Regresar" />

            <TextView
                android:id="@+id/txtDetalleNombreProyecto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toEndOf="@id/btnAtrasDetalle"
                android:layout_centerVertical="true"
                android:layout_marginStart="12dp"
                android:text="Proyecto X"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="#000000" />

            <Spinner
                android:id="@+id/spDetalleEstado"
                android:layout_width="140dp"
                android:layout_height="40dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@android:drawable/btn_dropdown"
                android:backgroundTint="#D9D3D3"
                android:paddingStart="12dp"
                android:spinnerMode="dropdown" />
        </RelativeLayout>

        <androidx.cardview.widget.CardView
            android:id="@+id/cardPersonal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/lytHeaderDetalle"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="2dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="20dp">

                <TextView
                    android:id="@+id/lblPersonal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Personal"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:textColor="#000000"
                    android:layout_marginBottom="14dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnElegirEncargado"
                    android:layout_width="180dp"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/lblPersonal"
                    android:text="Elegir Encargado\ndel Proyecto"
                    android:textAllCaps="false"
                    android:textSize="12sp"
                    android:gravity="center"
                    android:textColor="#FFFFFF"
                    app:backgroundTint="#1565C0"
                    app:icon="@android:drawable/ic_menu_my_calendar"
                    app:iconGravity="start"
                    app:cornerRadius="20dp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/lblPersonal"
                    android:layout_toEndOf="@id/btnElegirEncargado"
                    android:layout_marginStart="16dp"
                    android:layout_centerVertical="true"
                    android:orientation="vertical"
                    android:layout_marginTop="6dp">

                    <TextView
                        android:id="@+id/txtNombreEncargado"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="• Persona 1"
                        android:textColor="#000000"
                        android:textStyle="bold"
                        android:textSize="16sp"/>

                    <TextView
                        android:id="@+id/txtRolEncargado"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="(Ingeniero)"
                        android:textColor="#666666"
                        android:textSize="14sp"
                        android:layout_marginStart="10dp"/>
                </LinearLayout>
            </RelativeLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:id="@+id/cardMateriales"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/cardPersonal"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp"
                android:gravity="center_horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Definir Requerimientos de Materiales"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:textColor="#000000"
                    android:layout_marginBottom="12dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAgregarMateriales"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="Agregar Materiales"
                    android:textAllCaps="false"
                    android:textStyle="bold"
                    app:backgroundTint="#1565C0"
                    android:textColor="#FFFFFF"
                    app:cornerRadius="24dp"
                    android:layout_marginBottom="12dp"/>

                <androidx.core.widget.NestedScrollView
                    android:layout_width="match_parent"
                    android:layout_height="140dp"
                    android:fadeScrollbars="false"
                    android:scrollbars="vertical">

                    <TableLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:stretchColumns="*">

                        <TableRow android:layout_marginBottom="8dp">
                            <TextView android:text="Material" android:textStyle="bold" android:textColor="#000000" android:gravity="center" android:textSize="15sp"/>
                            <TextView android:text="Cantidad" android:textStyle="bold" android:textColor="#000000" android:gravity="center" android:textSize="15sp"/>
                            <TextView android:text="Unidad" android:textStyle="bold" android:textColor="#000000" android:gravity="center" android:textSize="15sp"/>
                        </TableRow>

                        <TableRow android:layout_marginBottom="6dp">
                            <TextView android:text="Cemento" android:textColor="#333333" android:gravity="center" android:textSize="15sp"/>
                            <TextView android:text="100" android:textColor="#333333" android:gravity="center" android:textSize="15sp"/>
                            <TextView android:text="U" android:textColor="#333333" android:gravity="center" android:textSize="15sp"/>
                        </TableRow>

                        <TableRow android:layout_marginBottom="6dp">
                            <TextView android:text="Hierro" android:textColor="#333333" android:gravity="center" android:textSize="15sp"/>
                            <TextView android:text="50" android:textColor="#333333" android:gravity="center" android:textSize="15sp"/>
                            <TextView android:text="QQ" android:textColor="#333333" android:gravity="center" android:textSize="15sp"/>
                        </TableRow>

                        <TableRow android:layout_marginBottom="6dp">
                            <TextView android:text="Arena" android:textColor="#333333" android:gravity="center" android:textSize="15sp"/>
                            <TextView android:text="12" android:textColor="#333333" android:gravity="center" android:textSize="15sp"/>
                            <TextView android:text="M3" android:textColor="#333333" android:gravity="center" android:textSize="15sp"/>
                        </TableRow>

                        <TableRow android:layout_marginBottom="6dp">
                            <TextView android:text="Grava" android:textColor="#333333" android:gravity="center" android:textSize="15sp"/>
                            <TextView android:text="8" android:textColor="#333333" android:gravity="center" android:textSize="15sp"/>
                            <TextView android:text="M3" android:textColor="#333333" android:gravity="center" android:textSize="15sp"/>
                        </TableRow>

                        <TableRow>
                            <TextView android:text="Ladrillo" android:textColor="#333333" android:gravity="center" android:textSize="15sp"/>
                            <TextView android:text="450" android:textColor="#333333" android:gravity="center" android:textSize="15sp"/>
                            <TextView android:text="U" android:textColor="#333333" android:gravity="center" android:textSize="15sp"/>
                        </TableRow>
                    </TableLayout>
                </androidx.core.widget.NestedScrollView>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:id="@+id/cardCostos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/cardMateriales"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Documentos y Costos"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:textColor="#000000"
                    android:layout_marginBottom="12dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:orientation="horizontal"
                    android:background="@android:drawable/edit_text"
                    android:backgroundTint="#FFFFFF"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="14dp"
                    android:layout_marginBottom="16dp"
                    android:elevation="1dp">
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@android:drawable/ic_menu_search"
                        app:tint="#666666"/>
                    <EditText
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="BUSCAR"
                        android:textSize="15sp"
                        android:background="@android:color/transparent"
                        android:paddingStart="8dp"
                        android:inputType="text"/>
                </LinearLayout>

                <TableLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:stretchColumns="*"
                    android:layout_marginBottom="18dp">

                    <TableRow android:layout_marginBottom="8dp">
                        <TextView android:text="Proveedor" android:textStyle="bold" android:textColor="#000000" android:gravity="start" android:textSize="15sp" android:paddingStart="8dp"/>
                        <TextView android:text="Valor" android:textStyle="bold" android:textColor="#000000" android:gravity="end" android:textSize="15sp" android:paddingEnd="8dp"/>
                    </TableRow>

                    <TableRow android:layout_marginBottom="8dp">
                        <View android:layout_height="1dp" android:background="#DDDDDD" android:layout_span="2"/>
                    </TableRow>

                    <LinearLayout
                        android:id="@+id/lytListaCotizacionesAgregadas"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_span="2">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:weightSum="2"
                            android:paddingVertical="6dp">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="• Proveedor A"
                                android:textColor="#333333"
                                android:textSize="15sp"
                                android:paddingStart="4dp"/>
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="$ 1,262.25"
                                android:textColor="#000000"
                                android:textStyle="bold"
                                android:gravity="end"
                                android:paddingEnd="4dp"/>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:weightSum="2"
                            android:paddingVertical="6dp">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="• Proveedor B "
                                android:textColor="#2E7D32"
                                android:textStyle="bold"
                                android:textSize="15sp"
                                android:paddingStart="4dp"/>
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="$ 1,050.00"
                                android:textColor="#2E7D32"
                                android:textStyle="bold"
                                android:gravity="end"
                                android:paddingEnd="4dp"/>
                        </LinearLayout>
                    </LinearLayout>
                </TableLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAgregarCotizacion"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="Agregar Cotización"
                    android:textAllCaps="false"
                    android:textStyle="bold"
                    app:backgroundTint="#1565C0"
                    android:textColor="#FFFFFF"
                    app:cornerRadius="24dp"
                    android:layout_marginBottom="8dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCompararCotizaciones"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="Comparar cotizaciones"
                    android:textAllCaps="false"
                    android:textStyle="bold"
                    android:textColor="#1565C0"
                    app:backgroundTint="#A9C9E8"
                    app:cornerRadius="24dp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGuardarDetalles"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_below="@id/cardCostos"
            android:text="Guardar"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            app:backgroundTint="#1565C0"
            app:cornerRadius="25dp"
            android:layout_marginBottom="24dp"/>

    </RelativeLayout>
</ScrollView>