<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    android:fillViewport="true">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <RelativeLayout
            android:id="@+id/lytHeaderDetalle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp">

            <TextView
                android:id="@+id/txtDetalleNombreProyecto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="12dp"
                android:text="Proyecto X"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="#000000" />

            <Spinner
                android:id="@+id/spDetalleEstado"
                android:layout_width="140dp"
                android:layout_height="40dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@android:drawable/btn_dropdown"
                android:backgroundTint="#D9D3D3"
                android:paddingStart="12dp"
                android:spinnerMode="dropdown" />
        </RelativeLayout>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardPersonal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/lytHeaderDetalle"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@android:color/white"
            app:strokeColor="#1565C0"
            app:strokeWidth="1dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="20dp">

                <TextView
                    android:id="@+id/lblPersonal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Personal"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:textColor="#000000"
                    android:layout_marginBottom="14dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnElegirEncargado"
                    android:layout_width="180dp"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/lblPersonal"
                    android:text="Elegir Encargado\ndel Proyecto"
                    android:textAllCaps="false"
                    android:textSize="12sp"
                    android:gravity="center"
                    android:textColor="#FFFFFF"
                    app:backgroundTint="#1565C0"
                    app:icon="@android:drawable/ic_menu_my_calendar"
                    app:iconGravity="start"
                    app:cornerRadius="20dp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/lblPersonal"
                    android:layout_toEndOf="@id/btnElegirEncargado"
                    android:layout_marginStart="16dp"
                    android:layout_centerVertical="true"
                    android:orientation="vertical"
                    android:layout_marginTop="6dp">

                    <TextView
                        android:id="@+id/txtNombreEncargado"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="• Persona 1"
                        android:textColor="#000000"
                        android:textStyle="bold"
                        android:textSize="16sp"/>


                </LinearLayout>
            </RelativeLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardMateriales"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/cardPersonal"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@android:color/white"
            app:strokeColor="#1565C0"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp"
                android:gravity="center_horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Definir Requerimientos de Materiales"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:textColor="#000000"
                    android:layout_marginBottom="12dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAgregarMateriales"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="Agregar Materiales"
                    android:textAllCaps="false"
                    android:textStyle="bold"
                    app:backgroundTint="#1565C0"
                    android:textColor="#FFFFFF"
                    app:cornerRadius="24dp"
                    android:layout_marginBottom="12dp"/>

                <androidx.core.widget.NestedScrollView
                    android:layout_width="match_parent"
                    android:layout_height="140dp"
                    android:fadeScrollbars="false"
                    android:scrollbars="vertical">

                    <TableLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:stretchColumns="*">

                        <TableRow android:layout_marginBottom="8dp">
                            <TextView android:text="Material" android:textStyle="bold" android:textColor="#000000" android:gravity="center" android:textSize="15sp"/>
                            <TextView android:text="Cantidad" android:textStyle="bold" android:textColor="#000000" android:gravity="center" android:textSize="15sp"/>
                            <TextView android:text="Unidad" android:textStyle="bold" android:textColor="#000000" android:gravity="center" android:textSize="15sp"/>
                        </TableRow>
                    </TableLayout>
                </androidx.core.widget.NestedScrollView>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardCostos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/cardMateriales"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@android:color/white"
            app:strokeColor="#1565C0"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Documentos y Costos"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:textColor="#000000"
                    android:layout_marginBottom="12dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAgregarCotizacion"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="Agregar Cotización"
                    android:textAllCaps="false"
                    android:textStyle="bold"
                    app:backgroundTint="#1565C0"
                    android:textColor="#FFFFFF"
                    app:cornerRadius="24dp"
                    android:layout_marginBottom="8dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCompararCotizaciones"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="Comparar cotizaciones"
                    android:textAllCaps="false"
                    android:textStyle="bold"
                    android:textColor="#1565C0"
                    app:backgroundTint="#A9C9E8"
                    app:cornerRadius="24dp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGuardarDetalles"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_below="@id/cardCostos"
            android:text="Guardar"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            app:backgroundTint="#1565C0"
            app:cornerRadius="25dp"
            android:layout_marginBottom="24dp"/>

    </RelativeLayout>
</ScrollView>