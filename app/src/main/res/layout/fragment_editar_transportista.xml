<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    android:padding="16dp">

    <LinearLayout
        android:id="@+id/lytHeaderEditar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_marginTop="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnAtrasEditar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="#000000" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Editar Transportista"
            android:textColor="#000000"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/lytHeaderEditar"
        app:layout_constraintBottom_toTopOf="@id/btnActualizarUsuario">

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="4dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="3dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="120dp"
                    android:layout_height="140dp"
                    android:layout_gravity="center"
                    android:layout_marginBottom="16dp">
                    <androidx.cardview.widget.CardView
                        android:id="@+id/cardFotoEditar"
                        android:layout_width="120dp"
                        android:layout_height="120dp"
                        app:cardCornerRadius="20dp"
                        app:cardBackgroundColor="#E0E0E0"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent">
                        <ImageView
                            android:layout_width="60dp"
                            android:layout_height="60dp"
                            android:layout_gravity="center"
                            android:src="@android:drawable/ic_menu_report_image"
                            app:tint="#666666" />
                    </androidx.cardview.widget.CardView>
                    <Button
                        android:id="@+id/btnCambiarFoto"
                        android:layout_width="110dp"
                        android:layout_height="32dp"
                        android:text="Cambiar Foto"
                        android:textSize="10sp"
                        android:backgroundTint="#1565C0"
                        android:textAllCaps="false"
                        app:cornerRadius="6dp"
                        app:layout_constraintTop_toBottomOf="@id/cardFotoEditar"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Nombre Completo" android:textStyle="bold" android:textColor="#000000"/>
                <EditText android:id="@+id/etNombreEditar" android:layout_width="match_parent" android:layout_height="45dp" android:background="@drawable/bg_input_rounded" android:hint="Nombre" android:paddingHorizontal="16dp" android:layout_marginBottom="12dp"/>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:weightSum="2" android:layout_marginBottom="12dp">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginEnd="6dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="DUI" android:textStyle="bold" android:textColor="#000000"/>
                        <EditText android:id="@+id/etDuiEditar" android:layout_width="match_parent" android:layout_height="45dp" android:background="@drawable/bg_input_rounded" android:hint="00000000-0" android:paddingHorizontal="16dp"/>
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="6dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="NIT" android:textStyle="bold" android:textColor="#000000"/>
                        <EditText android:id="@+id/etNitEditar" android:layout_width="match_parent" android:layout_height="45dp" android:background="@drawable/bg_input_rounded" android:hint="00000000-0" android:paddingHorizontal="16dp"/>
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:weightSum="2" android:layout_marginBottom="12dp">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginEnd="6dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Placa" android:textStyle="bold" android:textColor="#000000"/>
                        <EditText android:id="@+id/etPlacaEditar" android:layout_width="match_parent" android:layout_height="45dp" android:background="@drawable/bg_input_rounded" android:hint="P123-456" android:paddingHorizontal="16dp"/>
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="6dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="N° de Licencia" android:textStyle="bold" android:textColor="#000000"/>
                        <EditText android:id="@+id/etLicenciaEditar" android:layout_width="match_parent" android:layout_height="45dp" android:background="@drawable/bg_input_rounded" android:paddingHorizontal="16dp"/>
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:weightSum="2" android:layout_marginBottom="12dp">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginEnd="6dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Telefono" android:textStyle="bold" android:textColor="#000000"/>
                        <EditText android:id="@+id/etTelefonoEditar" android:layout_width="match_parent" android:layout_height="45dp" android:background="@drawable/bg_input_rounded" android:hint="2222-2222" android:paddingHorizontal="16dp"/>
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="6dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Tipo de Licencia" android:textStyle="bold" android:textColor="#000000"/>
                        <Spinner android:id="@+id/spTipoLicenciaEditar" android:layout_width="match_parent" android:layout_height="45dp" android:background="@drawable/bg_input_rounded" />
                    </LinearLayout>
                </LinearLayout>

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Correo Electronico" android:textStyle="bold" android:textColor="#000000"/>
                <EditText android:id="@+id/etCorreoEditar" android:layout_width="match_parent" android:layout_height="45dp" android:background="@drawable/bg_input_rounded" android:hint="nombre@Empresa.sv" android:paddingHorizontal="16dp"/>

            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </ScrollView>

    <Button
        android:id="@+id/btnActualizarUsuario"
        android:layout_width="match_parent"
        android:layout_height="45dp"
        android:layout_marginBottom="8dp"
        android:backgroundTint="#1565C0"
        android:text="Actualizar Usuario"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:textAllCaps="false"
        app:cornerRadius="10dp"
        app:layout_constraintBottom_toTopOf="@id/btnCancelarEditar" />

    <Button
        android:id="@+id/btnCancelarEditar"
        android:layout_width="match_parent"
        android:layout_height="45dp"
        android:layout_marginBottom="16dp"
        android:backgroundTint="#A9C9E8"
        android:text="Cancelar"
        android:textColor="#1565C0"
        android:textStyle="bold"
        android:textAllCaps="false"
        app:cornerRadius="10dp"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>